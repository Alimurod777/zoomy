TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_UPLOAD_ENABLED=false  # true = upload MP4 via Pyrofork/MTProto after recording
TELEGRAM_API_ID=               # from my.telegram.org (required even for a bot)
TELEGRAM_API_HASH=             # from my.telegram.org
TELEGRAM_SPLIT_MB=1900         # playable MP4 parts; 1..2000 MiB, below 2 GiB
AUTHORIZED_USER_IDS=123456789,987654321   # comma-separated Telegram user IDs; leave empty to allow all
OWNER_TELEGRAM_ID=466165038   # gets a one-time alert when an unauthorized user messages the bot
GUEST_NAME=zoomy.ircham.dev
RECORDINGS_DIR=/recordings
ZOOM_STATE_PATH=/secrets/zoom_state.json   # saved Zoom login for hosts requiring signed-in participants; create it with `python3 bot/zoom_login.py`. Missing file = anonymous guest join (previous behaviour)
MONGODB_URI=                # shared MongoDB/Atlas URI; blank = local Zoom state only
MONGODB_DATABASE=zoomy
MONGODB_LOCAL_ENABLED=false # true only after scripts/setup-mongodb.sh; external URI = false
MONGODB_AUTH_KEY=           # Fernet key; identical on every server using this auth
ZOOM_AUTH_ID=default        # shared browser account identity in MongoDB
ZOOM_AUTH_SYNC_SECONDS=60   # pull shared state to the local cache periodically
ZOOM_LOGIN_TIMEOUT=900      # Telegram browser-login timeout in seconds
ZOOM_LOGIN_MODE=link        # link = user logs in in browser; telegram = screenshot/input fallback
ZOOM_LOGIN_DISPLAY=90       # dedicated Xvfb display, separate from recordings
DEBUG=false   # set true to save debug screenshots to /recordings
ZOOM_CLEAN_RECORDING=true # full media fit, no profiles/toolbar/cursor
ZOOM_RECORDING_SOURCE=shared-only # Web App: shared-only or shared-and-speaker
RECORD_FPS=15 # 1..30; shared screens usually need fewer frames than camera video
FFMPEG_THREADS=2 # bounded encoding CPU threads
AUDIO_WAIT_TIMEOUT=5 # seconds, 0 = start immediately; recording starts even if still silent
ZOOM_RECORDING_ASPECT=auto # auto = media-shaped output, original = retain wide meeting frame
SETUP_EXPIRY_HOURS=3   # /record setup is abandoned if the start/schedule step goes unanswered this long
ZOOM_JOIN_MODE=auto # auto: Web App first, native Desktop if app-only; web or desktop to force
AUTO_RECORD_SETUP=true # /record URL starts immediately; false restores manual name/schedule setup
ZOOM_HOST_WAIT_SECONDS=7200 # background host/waiting-room deadline; /stop cancels immediately
ZOOM_CONNECT_TIMEOUT=30 # deadline per unresponsive join attempt; host/admission waits are separate
ZOOM_JOIN_ATTEMPTS=3 # retry unknown/temporary join pages; never reload the waiting room
ZOOM_JOIN_RETRY_SECONDS=30 # re-check not-started meetings; waiting rooms are never reloaded
ZOOM_RECONNECT_ATTEMPTS=5 # bounded recovery attempts after a connection loss
MAX_CONCURRENT_SESSIONS=1 # each recording needs its own Xvfb/Chrome/FFmpeg
AUTO_TRANSCRIBE=false # choose transcription manually; inference waits until recordings finish
WHISPER_MODEL=small # tiny | base | small | medium | large-v3
WHISPER_ALLOW_LARGE=false # opt in only when your host has enough RAM/CPU
WHISPER_JOB_TIMEOUT=1800 # bounded isolated worker; model RAM is released when it exits
WHISPER_LANGUAGE= # language code, e.g. uz; blank = auto-detect after speech is found
WHISPER_THREADS=2 # CPU threads for Whisper inference; default 2, maximum 8
WHISPER_INITIAL_PROMPT=   # primes context window with domain vocabulary; leave empty for default
WHISPER_HOTWORDS=         # comma-separated words to boost during transcription; leave empty for default

CLIPROXY_BASE_URL=http://cli-proxy-api:8317/v1  # internal CLIProxyAPI endpoint; do not use a public URL
CLIPROXY_API_KEY=your_cliproxy_api_key_here
SUMMARY_MODEL=gpt-5.6-luna                    # ChatGPT Codex model used for summaries and follow-up chat
SUMMARY_PREPROCESS_MODEL=gpt-5.6-luna         # model used to find clarification gaps before summarizing
SUMMARY_WEB_SEARCH=true                       # use ChatGPT Codex web_search; set false to disable it

AUDIO_WAIT_TIMEOUT=1     # any non-zero value enables audio-wait on join (waits indefinitely until audio detected); 0 = disabled (start immediately)
AUDIO_RMS_THRESHOLD=100  # minimum RMS level (0–32767) to consider "audio present"

SILENT_WARN_SECS=60      # seconds of continuous silence mid-recording before Telegram warning; 0 = disabled
SILENT_SNOOZE_SECS=300   # how long (seconds) a snooze suppresses further silence warnings

BREAKOUT_AUTOJOIN_SECS=100  # on a host breakout-room invite, prompt Telegram then auto-join after this many seconds; 0 = join immediately, negative = ignore invites

FILEBROWSER_ENABLED=false     # master switch for the Share Link buttons; off while recordings are deleted after the YouTube upload
FILEBROWSER_URL=              # e.g. https://share.ircham.dev; leave empty to disable the Share Link button
FILEBROWSER_API_TOKEN=        # long-lived API token created in FileBrowser Quantum's UI
FILEBROWSER_SOURCE_NAME=recordings  # source name as configured in FileBrowser Quantum's config.yaml
FILEBROWSER_SHARE_EXPIRY_DAYS=90    # share links auto-expire after this many days

YOUTUBE_TOKEN_PATH=/secrets/youtube_token.json  # created by bot/youtube_login.py; missing file = YouTube upload disabled
YOUTUBE_PRIVACY=unlisted      # unlisted | private | public
YOUTUBE_RETENTION_DAYS=7      # delete the local recording folder this many days after a successful upload
YOUTUBE_CATEGORY_ID=22        # YouTube category (22 = People & Blogs)
